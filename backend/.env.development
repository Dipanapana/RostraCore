# Development Environment (v2.0 - Transformation)
# This file serves as a template for development deployment on Railway

# Database - Separate development PostgreSQL instance
DATABASE_URL=postgresql://user:password@host:port/database_dev  # Replace with Railway dev PostgreSQL URL
REDIS_URL=redis://host:port                                     # Replace with Railway dev Redis URL

# Security
JWT_SECRET_KEY=${JWT_SECRET}                                # Set as Railway secret variable
SECRET_KEY=${SECRET_KEY}                                    # Set as Railway secret variable

# CORS - Development Frontend Domain
CORS_ORIGINS=http://localhost:3000,https://app-dev.rostracore.com  # Local + preview domain

# Environment
ENVIRONMENT=development

# Email (if configured)
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}

# Sentry (optional for dev)
# SENTRY_DSN=${SENTRY_DSN}

# Feature Flags (v2.0 - transformation features enabled)
ENABLE_BIOMETRIC_AUTH=true
ENABLE_FACIAL_RECOGNITION=true
ENABLE_GPS_GEOFENCE=true
ENABLE_MULTI_COUNTRY=true
ENABLE_INTERNATIONALIZATION=true

# Debug
DEBUG=true
