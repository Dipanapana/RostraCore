# Production Environment (v1.0)
# This file serves as a template for production deployment on Railway

# Database
DATABASE_URL=postgresql://user:password@host:port/database  # Replace with Railway production PostgreSQL URL
REDIS_URL=redis://host:port                                 # Replace with Railway production Redis URL

# Security
JWT_SECRET_KEY=${JWT_SECRET}                                # Set as Railway secret variable
SECRET_KEY=${SECRET_KEY}                                    # Set as Railway secret variable

# CORS - Production Frontend Domain
CORS_ORIGINS=https://app.rostracore.com                     # Replace with actual production domain

# Environment
ENVIRONMENT=production

# Email (if configured)
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}

# Sentry (if configured)
SENTRY_DSN=${SENTRY_DSN}

# Feature Flags (v1.0 - stable features only)
ENABLE_BIOMETRIC_AUTH=false
ENABLE_FACIAL_RECOGNITION=false
ENABLE_GPS_GEOFENCE=false
