{
  "name": "rostracore-desktop",
  "version": "1.0.0",
  "description": "RostraCore Desktop Application - Multi-type HR & Risk Management Platform",
  "main": "dist/main.js",
  "author": "RostraCore Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "tsc && electron .",
    "build:ts": "tsc",
    "build:frontend": "cd ../frontend && npm run build:desktop",
    "build:all": "npm run build:frontend && npm run build:ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@types/node": "^20.10.6",
    "electron": "^28.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "config": {
    "forge": "./forge.config.js"
  }
}
