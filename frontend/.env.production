# Frontend Production Environment (v1.0)

# API URL - Production Backend
NEXT_PUBLIC_API_URL=https://api.rostracore.com  # Replace with actual production Railway backend URL

# Environment
NEXT_PUBLIC_ENVIRONMENT=production

# Feature Flags (v1.0 - stable features only)
NEXT_PUBLIC_ENABLE_BIOMETRIC_AUTH=false
NEXT_PUBLIC_ENABLE_FACIAL_RECOGNITION=false
NEXT_PUBLIC_ENABLE_GPS_GEOFENCE=false
