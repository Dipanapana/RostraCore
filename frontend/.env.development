# Frontend Development Environment (v2.0 - Transformation)

# API URL - Development Backend
NEXT_PUBLIC_API_URL=https://api-dev.rostracore.com  # Replace with dev Railway backend URL

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags (v2.0 - transformation features enabled)
NEXT_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
NEXT_PUBLIC_ENABLE_FACIAL_RECOGNITION=true
NEXT_PUBLIC_ENABLE_GPS_GEOFENCE=true
NEXT_PUBLIC_ENABLE_MULTI_COUNTRY=true
NEXT_PUBLIC_ENABLE_INTERNATIONALIZATION=true

# Debug
NEXT_PUBLIC_DEBUG=true
